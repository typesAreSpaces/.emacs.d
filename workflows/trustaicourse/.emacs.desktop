(setq register-alist '((97 . [105 42 46 escape 106 94]) (48 . #("\\documentclass{article}\n\\usepackage{fullpage}\n\\usepackage{amsmath}\n\\usepackage{enumitem}\n\\usepackage{tikz}\n\\usetikzlibrary{arrows.meta,positioning,automata}\n\\usepackage{array}\n\\usepackage{booktabs}\n\\usepackage{hyperref}\n\\setlist[enumerate]{itemsep=0.5em, topsep=0.5em}\n\\newcommand{\\TS}{\\mathit{TS}}\n\\input{macros}\n\n\\setlength{\\parskip}{.4cm}\n\\setlength{\\baselineskip}{15pt}\n\\setlength{\\parindent}{0cm}\n\n\\author{}\n\\date{}\n\n\\begin{document}\n\n\\hrule\n\\begin{center}\n  {\\LARGE \\sc $\\underline{\\mbox{Homework 3}}$} \\\\\n  {\\Large \\sc CS~591: Trustworthy AI and Autonomous Systems}\\\\\n  \\ \\\\\n  \\begin{tabular}{ll}\n    Assigned:  & Due on: \n  \\end{tabular}\n\\end{center}\n\\hrule\n\\begin{problem}\n\n  Consider the transition system \\(\\TS\\) shown below. \n\n  \\begin{center}\n    \\begin{tikzpicture}[\n      ->, >=Stealth, shorten >=1pt, auto,\n      node distance=2.1cm and 2.4cm,\n      semithick,\n      every state/.style={minimum size=1.05cm}\n      ]\n      \\node[state, initial] (s0) {$s_0$};\n      \\node[state, above right=of s0] (s1) {$s_1$};\n      \\node[state, below right=of s0] (s2) {$s_2$};\n      \\node[state, right=of s1] (s3) {$s_3$};\n      \\node[state, right=of s2] (s4) {$s_4$};\n      \\node[state, right=2.8cm of s3] (s5) {$s_5$};\n      \\node[state, below=2.1cm of s5] (s6) {$s_6$};\n      \\node[state, right=2.8cm of s5] (s7) {$s_7$};\n\n      \\path\n      (s0) edge (s1)\n      edge (s2)\n      (s1) edge (s3)\n      edge[bend right=10] (s4)\n      (s2) edge[bend left=10] (s3)\n      edge (s4)\n      (s3) edge (s5)\n      edge[bend right=15] (s6)\n      (s4) edge[bend left=15] (s5)\n      edge (s6)\n      (s5) edge[loop above] (s5)\n      edge (s7)\n      (s6) edge[loop below] (s6)\n      (s7) edge[loop above] (s7);\n    \\end{tikzpicture}\n  \\end{center}\n\n  The initial state is \\(s_0\\). The set of atomic propositions is\n  \\[\n    AP=\\{\\mathit{idle},\\mathit{request},\\mathit{processing},\\mathit{done},\\mathit{error}\\}.\n  \\]\n  The labeling function is\n  \\[\n    \\begin{array}{c|c}\n      \\toprule\n      \\text{State} & L(s)\\\\\n      \\midrule\n      s_0 & \\{\\mathit{idle}\\}\\\\\n      s_1 & \\{\\mathit{request}\\}\\\\\n      s_2 & \\{\\mathit{request}\\}\\\\\n      s_3 & \\{\\mathit{processing}\\}\\\\\n      s_4 & \\{\\mathit{processing}\\}\\\\\n      s_5 & \\{\\mathit{processing}\\}\\\\\n      s_6 & \\{\\mathit{done}\\}\\\\\n      s_7 & \\{\\mathit{error}\\}\\\\\n      \\bottomrule\n    \\end{array}\n  \\]\n  The unsafe-state set is \\(U=\\{s_7\\}\\).\n\n  Use three Boolean variables \\(x=(x_1,x_2,x_3)\\) to encode the states as follows:\n  \\[\n    \\begin{array}{c|ccc}\n      \\toprule\n      \\text{State} & x_1 & x_2 & x_3\\\\\n      \\midrule\n      s_0 & 0 & 0 & 0\\\\\n      s_1 & 0 & 0 & 1\\\\\n      s_2 & 0 & 1 & 0\\\\\n      s_3 & 0 & 1 & 1\\\\\n      s_4 & 1 & 0 & 0\\\\\n      s_5 & 1 & 0 & 1\\\\\n      s_6 & 1 & 1 & 0\\\\\n      s_7 & 1 & 1 & 1\\\\\n      \\bottomrule\n    \\end{array}\n  \\]\n\n  \\begin{enumerate}[label=(\\alph*)]\n  \\item \n    Write a Boolean formula for each state in terms of \\(x_1,x_2,x_3\\). Then construct:\n    \\begin{enumerate}[label=(\\roman*)]\n    \\item the initial-state formula \\(I(x)\\), and\n    \\item the unsafe-state formula \\(U(x)\\).\n    \\end{enumerate}\n\n  \\item \n    Let\n    \\[\n      x=(x_1,x_2,x_3), \\qquad x'=(x_1',x_2',x_3').\n    \\]\n    Construct the complete Boolean transition relation\n    \\[\n      T(x,x')\n    \\]\n    as a disjunction of Boolean terms, with one term for every transition shown in the graph.\n\n    For example, the transition \\(s_0\\rightarrow s_1\\) contributes\n    \\[\n      (\\neg x_1\\land \\neg x_2\\land \\neg x_3)\n      \\land\n      (\\neg x_1'\\land \\neg x_2'\\land x_3').\n    \\]\n    Write the terms corresponding to all remaining transitions and combine them to obtain \\(T(x,x')\\).\n\n  \\item \n    Consider executions of the form\n    \\[\n      s^0\\rightarrow s^1\\rightarrow s^2\\rightarrow s^3\\rightarrow s^4.\n    \\]\n    Construct the BMC formula for reaching the unsafe state at the last position:\n    \\[\n      \\Phi_4=\n      I(x^0)\n      \\land T(x^0,x^1)\n      \\land T(x^1,x^2)\n      \\land T(x^2,x^3)\n      \\land T(x^3,x^4)\n      \\land U(x^4).\n    \\]\n    You may use your definition of \\(T\\) from part (b) without expanding every copy of it again.\n\n  \\item \n    Determine whether \\(\\Phi_4\\) is SAT or UNSAT. If it is SAT:\n    \\begin{enumerate}[label=(\\roman*)]\n    \\item give one satisfying sequence of states;\n    \\item give the corresponding Boolean valuation of \\(x^0,x^1,x^2,x^3,x^4\\); and\n    \\item explain why this execution is a counterexample to\n      \\[\n        \\boxed{\\text{The system never reaches a state labeled }\\mathit{error}.}\n      \\]\n    \\end{enumerate}\n\n  \\item \n    Now consider only three transitions:\n    \\[\n      \\Phi_3=\n      I(x^0)\n      \\land T(x^0,x^1)\n      \\land T(x^1,x^2)\n      \\land T(x^2,x^3)\n      \\land U(x^3).\n    \\]\n    Determine whether \\(\\Phi_3\\) is SAT or UNSAT. Explain the difference between the results for \\(\\Phi_3\\) and \\(\\Phi_4\\), and state what an UNSAT result means in bounded model checking.\n  \\end{enumerate}\n\\end{problem}\n\n\\begin{problem} \n\n  Use the same transition system $\\TS$ from Problem 1.\n\n  \\begin{enumerate}[label=(\\alph*)]\n  \\item \n    Partition the state space according to the labeling function. That is, place states with identical labels in the same block. Write the resulting initial partition \\(P_0\\).\n\n  \\item \n    For each pair\n    \\[\n      (s_1,s_2), \\qquad (s_3,s_4), \\qquad (s_3,s_5), \\qquad (s_4,s_5),\n    \\]\n    determine whether the two states can be bisimilar. For each pair:\n    \\begin{enumerate}[label=(\\roman*)]\n    \\item check whether the states have the same labeling;\n    \\item compare their outgoing transitions;\n    \\item check whether every transition from the first state can be matched by a transition from the second state to a related state; and\n    \\item check the same condition in the opposite direction.\n    \\end{enumerate}\n    Give a short justification for each conclusion.\n\n  \\item \n    Starting from\n    \\[\n      P_0=\n      \\big\\{\n      \\{s_0\\},\n      \\{s_1,s_2\\},\n      \\{s_3,s_4,s_5\\},\n      \\{s_6\\},\n      \\{s_7\\}\n      \\big\\},\n    \\]\n    refine the partition until every block is stable under the bisimulation conditions.\n\n    For each refinement step:\n    \\begin{enumerate}[label=(\\roman*)]\n    \\item identify any block that must be split;\n    \\item explain which transition behavior causes the split; and\n    \\item write the new partition.\n    \\end{enumerate}\n    Continue until no block needs to be split.\n\n  \\item \n    Using the final partition, write a bisimulation relation \\(R\\subseteq S\\times S\\) that relates all states belonging to the same bisimulation-equivalence class.\n\n    % \\item \n    %   Construct the quotient transition system\n    %   \\[\n    %     \\TS/{\\sim}.\n    %   \\]\n    %   Include:\n    %   \\begin{enumerate}[label=(\\roman*)]\n    %   \\item the quotient states;\n    %   \\item the initial quotient state;\n    %   \\item the labels of the quotient states;\n    %   \\item all quotient transitions; and\n    %   \\item a drawing of the quotient transition-system graph.\n    %   \\end{enumerate}\n\n    % \\item \\textbf{Verification on the quotient.}\n    %   Consider again the safety property\n    %   \\[\n    %     \\Box\\neg \\mathit{error}.\n    %   \\]\n    %   Answer the following:\n    %   \\begin{enumerate}[label=(\\roman*)]\n    %   \\item Does the original transition system satisfy the property?\n    %   \\item Does the quotient transition system satisfy the property?\n    %   \\item Give a shortest counterexample in the original system and a corresponding counterexample in the quotient system.\n    %   \\item Briefly explain why verification on the quotient system can be advantageous.\n    %   \\end{enumerate}\n  \\end{enumerate}\n\n  % \\section*{Optional: Symbolic Reachability / BDD Practice}\n\n  % Using the same Boolean encoding and transition relation from Problem 1, let\n  % \\[\n  %   R_0(x)=I(x).\n  % \\]\n\n  % \\begin{enumerate}[label=(\\alph*)]\n  % \\item Compute\n  %   \\[\n  %     N_1(x')=\\exists x\\,[R_0(x)\\land T(x,x')].\n  %   \\]\n  %   Identify the states represented by \\(N_1\\), rename \\(x'\\rightarrow x\\), and compute\n  %   \\[\n  %     R_1=R_0\\lor N_1.\n  %   \\]\n\n  % \\item Repeat the symbolic successor computation to obtain \\(R_2,R_3,\\ldots\\) until a fixed point is reached. At each iteration, list the newly discovered states.\n\n  % \\item State the final reachable-state set and the iteration at which the fixed point is reached.\n\n  % \\item Explain how existential quantification can be computed using restriction:\n  %   \\[\n  %     \\exists x_i\\,f\n  %     =\n  %     f\\big|_{x_i=0}\\lor f\\big|_{x_i=1}.\n  %   \\]\n  % \\end{enumerate}\n\n\\end{problem}\n\n\\begin{problem}\n\n  Consider the autonomous two-dimensional linear dynamical system\n  \\[\n    \\dot{x}(t)=Ax(t),\n    \\qquad\n    x(t)\\in\\mathbb{R}^2,\n  \\]\n  where\n  \\[\n    A=\\begin{bmatrix}\n      0 & 1\\\\\n      -2 & -3\n    \\end{bmatrix},\n    \\qquad\n    x(0)=\\begin{bmatrix}\n      2\\\\\n      0\n    \\end{bmatrix}.\n  \\]\n\n  \\begin{enumerate}[label=(\\alph*)]\n\n  \\item \n    Compute the eigenvalues of $A$ and one corresponding eigenvector for each eigenvalue. Using these eigenvectors, construct matrices $P$ and $D$ such that\n    \\[\n      A=PDP^{-1}.\n    \\]\n    Also compute $P^{-1}$.\n\n  \\item \n    Using the diagonalization from part (a), compute\n    \\[\n      e^{Dt}\n    \\]\n    and then determine the state-transition matrix\n    \\[\n      e^{At}=Pe^{Dt}P^{-1}.\n    \\]\n    Show the main steps of your matrix computation.\n\n  \\item  Using your result for $e^{At}$, derive the explicit closed-form trajectory\n    \\[\n      x(t)=e^{At}x(0).\n    \\]\n\n  \\item Based on the eigenvalues of $A$, classify the equilibrium at the origin as one of the following: \\emph{stable node, unstable node, saddle point,} or \\emph{focus}. Briefly justify your answer and describe the behavior of trajectories as $t\\to\\infty$.\n\n  \\end{enumerate}\n\\end{problem}\n\n% The characteristic polynomial is\n% \\[\n%   \\det(A-\\lambda I)\n%   =\n%   \\det\\begin{bmatrix}\n    %     -\\lambda & 1\\\\\n% -2 & -3-\\lambda\n% \\end{bmatrix}\n% =\n% \\lambda^2+3\\lambda+2\n% =\n% (\\lambda+1)(\\lambda+2).\n% \\]\n% Hence,\n% \\[\n% \\lambda_1=-1,\n% \\qquad\n% \\lambda_2=-2.\n% \\]\n\n% For $\\lambda_1=-1$,\n% \\[\n% (A+I)v_1=0\n% \\quad\\Longrightarrow\\quad\n% v_1=\n% \\begin{bmatrix}\n% 1\\\\\n% -1\n% \\end{bmatrix}.\n% \\]\n\n% For $\\lambda_2=-2$,\n% \\[\n% (A+2I)v_2=0\n% \\quad\\Longrightarrow\\quad\n% v_2=\n% \\begin{bmatrix}\n% 1\\\\\n% -2\n% \\end{bmatrix}.\n% \\]\n\n% Thus, one valid diagonalization is\n% \\[\n% P=\n% \\begin{bmatrix}\n% 1 & 1\\\\\n% -1 & -2\n% \\end{bmatrix},\n% \\qquad\n% D=\n% \\begin{bmatrix}\n% -1 & 0\\\\\n% 0 & -2\n% \\end{bmatrix}.\n% \\]\n% Since $\\det(P)=-1$,\n% \\[\n% P^{-1}\n% =\n% \\begin{bmatrix}\n% 2 & 1\\\\\n% -1 & -1\n% \\end{bmatrix}.\n% \\]\n\n% \\subsection*{(b) Matrix exponential}\n% Since $D$ is diagonal,\n% \\[\n% e^{Dt}\n% =\n% \\begin{bmatrix}\n% e^{-t} & 0\\\\\n% 0 & e^{-2t}\n% \\end{bmatrix}.\n% \\]\n% Therefore,\n% \\[\n% e^{At}=Pe^{Dt}P^{-1}.\n% \\]\n% First,\n% \\[\n% Pe^{Dt}\n% =\n% \\begin{bmatrix}\n% e^{-t} & e^{-2t}\\\\\n% -e^{-t} & -2e^{-2t}\n% \\end{bmatrix}.\n% \\]\n% Hence,\n% \\[\n% e^{At}\n% =\n% \\begin{bmatrix}\n% 2e^{-t}-e^{-2t} & e^{-t}-e^{-2t}\\\\\n% -2e^{-t}+2e^{-2t} & -e^{-t}+2e^{-2t}\n% \\end{bmatrix}.\n% \\]\n\n% \\subsection*{(c) System trajectory and equilibrium classification}\n% Using the initial condition,\n% \\[\n% x(t)=e^{At}x(0)\n% =\n% \\begin{bmatrix}\n% 2e^{-t}-e^{-2t} & e^{-t}-e^{-2t}\\\\\n% -2e^{-t}+2e^{-2t} & -e^{-t}+2e^{-2t}\n% \\end{bmatrix}\n% \\begin{bmatrix}\n% 2\\\\\n% 0\n% \\end{bmatrix}.\n% \\]\n% Thus,\n% \\[\n% \\boxed{\n% x(t)=\n% \\begin{bmatrix}\n% 4e^{-t}-2e^{-2t}\\\\\n% -4e^{-t}+4e^{-2t}\n% \\end{bmatrix}.}\n% \\]\n\n% Because the eigenvalues $-1$ and $-2$ are real, distinct, and strictly negative, the origin is an \\textbf{asymptotically stable node}. Every trajectory converges exponentially to the origin as $t\\to\\infty$.\n% \\fi\n\n% \\section*{Optional: Symbolic Reachability / BDD Practice}\n\n% Using the same Boolean encoding and transition relation from Problem 1, let\n% \\[\n% R_0(x)=I(x).\n% \\]\n\n% \\begin{enumerate}[label=(\\alph*)]\n% \\item Compute\n% \\[\n% N_1(x')=\\exists x\\,[R_0(x)\\land T(x,x')].\n% \\]\n% Identify the states represented by \\(N_1\\), rename \\(x'\\rightarrow x\\), and compute\n% \\[\n% R_1=R_0\\lor N_1.\n% \\]\n\n% \\item Repeat the symbolic successor computation to obtain \\(R_2,R_3,\\ldots\\) until a fixed point is reached. At each iteration, list the newly discovered states.\n\n% \\item State the final reachable-state set and the iteration at which the fixed point is reached.\n\n% \\item Explain how existential quantification can be computed using restriction:\n% \\[\n% \\exists x_i\\,f\n% =\n% f\\big|_{x_i=0}\\lor f\\big|_{x_i=1}.\n% \\]\n% \\end{enumerate}\n\n\\begin{problem}\n\n  Consider the non-linear dynamical systems $\\mathcal{D}$ given by\n\n  \\begin{equation*} \n    \\begin{split}\n      \\begin{bmatrix}\n        \\dot{x_1}\\\\\n        \\dot{x_2}\n      \\end{bmatrix}\n      = F(x_1, x_2)\n      = \\begin{bmatrix}\n        x_2 - x_1^3\\\\\n        x_1 - x_2^3\n      \\end{bmatrix} \n    \\end{split}\n  \\end{equation*}\n  \n  \\begin{enumerate}[label=(\\alph*)]\n  \\item\n    Compute the equilibrium points of $\\mathcal{D}$.\n  \\item Linearize $\\mathcal{D}$ by computing the Jacobian matrix at each\n    equilibrium point. Conclude if $\\mathcal{D}$ is stable or not at each of its\n    equilibrium points.\n  \\item Consider the function\n    $V(x_1, x_2) = (x_1 - x_2)^{2}$. Is $V$ a Lyapunov function for some\n    equilibrium point of $\\mathcal{D}$?\n  \\end{enumerate}\n\n\\end{problem}\n\n\\begin{problem}\n\n  Consider the non-linear dynamical system $\\mathcal{D}$ given by\n\n  \\begin{equation*}\n    \\begin{split}\n      \\begin{bmatrix}\n        \\dot{x_1}\\\\\n        \\dot{x_2}\\\\\n        \\dot{x_3}\n      \\end{bmatrix}\n      = F(x_1, x_2)\n      = \\begin{bmatrix}\n        -x_1 - x_1^3\\\\\n        -x_2 - x_2^3\\\\\n        -x_3 - x_3^3\\\\\n      \\end{bmatrix} \n    \\end{split}\n  \\end{equation*}\n\n  \\begin{enumerate}[label=(\\alph*)]\n  \\item Find a Lyapunov function that proves the stability of $\\mathcal{D}$ at\n    the point $(0, 0, 0)$.\n    Consider the template $V(x_1, x_2, x_3) = a x_1^2 + b x_2 ^2 + c x_3^2$ and\n    use the SOSTOOLS package to find appropriate values for $a, b, c$.\n  \\item Prove that the function obtained in the previous item is a Lyapunov\n    function.\n  \\end{enumerate}\n\n\\end{problem}\n\n\\end{document}\n" 0 14 (face (font-lock-keyword-face font-latex-sedate-face) fontified t) 14 15 (fontified t) 15 22 (face (font-lock-function-name-face) fontified t) 22 23 (fontified t) 23 24 (font-lock-multiline t fontified t) 24 35 (face (font-lock-keyword-face font-latex-sedate-face) fontified t) 35 36 (fontified t) 36 44 (face (font-lock-function-name-face) fontified t) 44 45 (fontified t) 45 46 (font-lock-multiline t fontified t) 46 57 (face (font-lock-keyword-face font-latex-sedate-face) fontified t) 57 58 (fontified t) 58 65 (face (font-lock-function-name-face) fontified t) 65 66 (fontified t) 66 67 (font-lock-multiline t fontified t) 67 78 (face (font-lock-keyword-face font-latex-sedate-face) fontified t) 78 79 (fontified t) 79 87 (face (font-lock-funct