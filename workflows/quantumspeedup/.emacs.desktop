(setq register-alist '((48 . #("\\begin{frame}{The multiplicative weights algorithm}\n Initialize $w_i^{(1)}=1$ with $0<\\eta\\le\\tfrac12$.\n \\vspace{3mm}\n For each round $t=1,\\ldots,T$:\n \\begin{enumerate}\\setlength{\\itemsep}{3mm}\n  \\item Normalize the weights and sample a decision:\n   \\[\\Phi^{(t)}:=\\sum_{i=1}^n w_i^{(t)},\\qquad\n      p_i^{(t)}:=\\frac{w_i^{(t)}}{\\Phi^{(t)}}.\\]\n  \\item Observe the cost vector $m^{(t)}$.\n  \\item Update every weight:\n   \\[\\boxed{w_i^{(t+1)}:=w_i^{(t)}\\bigl(1-\\eta m_i^{(t)}\\bigr).}\\]\n \\end{enumerate}\n % Source typo: Phi summed w_n rather than w_i; summation index corrected here.\n\\end{frame}" 0 6 (face (font-lock-keyword-face font-latex-sedate-face) fontified t) 6 7 (fontified t) 7 12 (face (font-lock-function-name-face) fontified t) 12 64 (fontified t) 64 66 (face font-latex-math-face fontified t) 66 67 (face (font-latex-script-char-face font-latex-math-face) fontified t) 67 68 (face font-latex-math-face fontified t) 68 69 (face (font-latex-script-char-face font-latex-math-face) fontified t) 69 77 (face font-latex-math-face fontified t) 77 83 (fontified t) 83 86 (face font-latex-math-face fontified t) 86 90 (face (font-latex-math-face font-latex-sedate-face) fontified t) 90 93 (face (font-latex-math-face font-latex-sedate-face) fontified t) 93 99 (face (font-latex-math-face font-latex-sedate-face) fontified t) 99 102 (face font-latex-math-face fontified t) 102 105 (fontified t) 105 112 (face (font-lock-keyword-face font-latex-sedate-face) fontified t) 112 113 (fontified t) 113 116 (face (font-lock-function-name-face) fontified t) 116 134 (fontified t) 134 139 (face font-latex-math-face fontified t) 139 145 (face (font-latex-math-face font-latex-sedate-face) fontified t) 145 148 (face font-latex-math-face fontified t) 148 151 (fontified t) 151 157 (face (font-lock-keyword-face font-latex-sedate-face) fontified t) 157 158 (fontified t) 158 167 (face (font-lock-function-name-face) fontified t) 167 168 (fo