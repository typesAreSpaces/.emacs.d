(setq register-alist '((97 . [47 69 78 65 return 100 97 119 120 100 97 119 120 escape 94]) (48 . #("In this section, we compute certificates for all natural generators in a\nsaturated quadratic module given on the generators of the form\n$\\{p_{isolated}, -p_{isolated}\\}$ where\n$p_{isolated} :=\n\\sum_{i=1}^{n}{(x-a_i)}$. Table~\\ref{tab:comp-cert-natur-heuristics-fixed}\nreports the results obtained for this benchmark.\n\n% # Number of isolated points & Max degree & Average degree & Average time &\n% # Total time & Ratio of success\n\n\\begin{table}[htpb]\n  \\centering\n  \\color{red}\n  \\label{tab:comp-cert-natur-heuristics-fixed}\n  \\begin{tabular}{c|ccc|cc|c}\n    % \\sisetup{table-format = 2.2, table-alignment-mode = format}\n    \\multirow{2}{2.5cm}{\\makecell{Number of\\\\isolated points}}&\n    \\multicolumn{3}{c|}{Degree of certificates}&\n    \\multicolumn{2}{c|}{Time (seconds)}&\n    \\multirow{2}{3cm}{\\makecell{Number of\\\\certificates computed}}\\\\\n    \\cline{2-6}\n    & Maximum & Average & Median & Average & Total & \\\\\n    \\hline\n    2 & 8 & 4 & 2 & 0.071 & 0.213 & 3/3 \\\\\n    4 & 80 & 30.4 & 8 & 0.304 & 1.52 & 5/5 \\\\\n    6 & 1222 & 247.143 & 70 & 2.859 & 20.015 & 7/7 \\\\\n    8 & 16828 & 3417.333 & 220 & 3.824 & 34.413 & 9/9 \\\\\n    10 & 94514 & 14246 & 1314 & 28.523 & 313.753 & 11/11 \\\\\n  \\end{tabular}\n  \\caption{Computing certificates of natural generators}\n\\end{table}\n\n% # Number of isolated points & Max degree & Average degree & Average time &\n% # Total time & Ratio of success\n\\begin{table}[htpb]\n  \\centering\n  \\label{tab:comp-cert-natur-heuristics-fixed-updated}\n  \\begin{tabular}{c|ccc|cc|c}\n    % \\sisetup{table-format = 2.2, table-alignment-mode = format}\n    \\multirow{2}{2.5cm}{\\makecell{Number of\\\\isolated points}}&\n    \\multicolumn{3}{c|}{Degree of certificates}&\n    \\multicolumn{2}{c|}{Time (seconds)}&\n    \\multirow{2}{3cm}{\\makecell{Number of\\\\certificates computed}}\\\\\n    \\cline